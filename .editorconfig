# .NET EditorConfig
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trailing_whitespace = trim

[*.cs]
csharp_style_var_when_type_is_apparent = true:warning
dotnet_sort_system_directives_first = true:warning
dotnet_style_require_accessibility_modifiers = always:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_expression_bodied_methods = when_on_single_line:warning
csharp_style_prefer_expression_bodied_properties = when_on_single_line:warning
csharp_style_prefer_expression_bodied_constructors = when_on_single_line:warning
csharp_style_prefer_expression_bodied_operators = when_on_single_line:warning
csharp_style_prefer_index_expression = true:warning
csharp_style_prefer_is_null_check_over_reference_equality_method = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_throw_expression = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_prefer_readonly_structs = true:warning
csharp_style_prefer_simplicit_methods = true:warning
csharp_style_prefer_switch_expression = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
csharp_style_prefer_inferred_tuple_names = true:warning
csharp_style_prefer_auto_properties = true:warning

[*.{json,md,yml,yaml}]
indent_size = 2
